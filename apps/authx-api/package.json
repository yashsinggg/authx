    "@elysiajs/swagger": "^1.1.6",
    "bcrypt": "^5.1.1",
    "drizzle-orm": "^0.37.0",
    "elysia": "latest",
    "http-status-codes": "^2.3.0",
    "logestic": "^1.2.4",
    "pg": "^8.13.1",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
